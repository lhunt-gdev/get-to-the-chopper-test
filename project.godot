; Engine configuration file.
; Edit through Project > Project Settings where possible.

config_version=5

[application]

config/name="HOT EXFIL"
config/description="HOT EXFIL: a PS1-style action runner for your phone. Fight your way out and reach the chopper before it lifts off. Proof-of-concept build."
run/main_scene="res://game/levels/prototype_slice/prototype_slice.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[audio]

; Web: Godot mixes the sound itself and streams it out ("Stream"), as on desktop. Its default
; on the web ("Sample", the browser plays each sound) never looped loops and, with our buses,
; routed every sound to nothing.
general/default_playback_type.web=0
driver/output_latency.web=80

[autoload]

RunLog="*res://game/autoload/run_log.gd"
GameState="*res://game/autoload/game_state.gd"
Settings="*res://game/autoload/settings.gd"

[display]

window/size/viewport_width=270
window/size/viewport_height=480
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=true
anti_aliasing/quality/msaa_3d=0

[shader_globals]

amb_color={
"type": "vec4",
"value": Vector4(1, 1, 1, 1)
}
moon_color={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
