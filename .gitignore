# Godot 4 cache / imports (regenerated on open)
.godot/
*.import~
# Builds
build/
*.apk
*.aab
*.ipa
# Export credentials (Godot keeps these in .godot/, but never commit signing files)
*.p12
*.mobileprovision
*.keystore
# OS / editor noise
.DS_Store
Thumbs.db
*.tmp
.vscode/
.idea/
# Written by CI at export time (the build number on the main menu)
game/build_info.json

# CROSS source art: the 46 MB Meshy model and the pipeline's working files stay out of git (they're
# rebuilt by art_source/operative/tools/build_cross.sh); the scripts, README and reference sheet go in.
art_source/operative/ernest-cross.glb
art_source/operative/work/
# Blender backups and Python bytecode.
*.blend1
__pycache__/
# The guard's source art, the same way (rebuilt by art_source/operative/tools/build_guard.sh).
art_source/guard/guard-meshy.glb
art_source/guard/work/
# The scout's, boss's and dog's source art, the same way (rebuilt by build_character.sh /
# build_dog.sh in art_source/operative/tools).
art_source/scout/scout.glb
art_source/scout/work/
art_source/boss/boss.glb
art_source/boss/work/
art_source/dog/dog.glb
art_source/dog/work/
